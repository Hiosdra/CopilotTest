# Files and directories to exclude from npm package
# Note: package.json "files" field specifies what to include,
# but .npmignore provides additional exclusion control

# Source files (TypeScript)
src/
tsconfig.json

# Tests
tests/
*.spec.ts
*.test.ts

# Examples (users can view on GitHub)
examples/

# Documentation (available on GitHub)
docs/

# Development files
.github/
.vscode/
.idea/

# Build artifacts
*.tsbuildinfo
*.js.map

# Test results
copilot-test-results/
test-results/
coverage/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE files
*.swp
*.swo
*~

# Temporary files
tmp/
temp/

# Git files
.git/
.gitignore
.gitattributes

# CI/CD files
.travis.yml
.gitlab-ci.yml
azure-pipelines.yml

# Package manager files
.npmrc
.yarnrc
yarn.lock
pnpm-lock.yaml

# Misc
.editorconfig
.prettierrc
.eslintrc*
.prettierignore
.eslintignore
